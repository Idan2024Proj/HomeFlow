# Supabase (public — safe in browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server only — NEVER expose to the browser or commit real values
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Allow first-user household bootstrap even if households already exist (dev only)
ALLOW_BOOTSTRAP_SIGNUP=true

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shopping TXT import (max file size in KB)
SHOPPING_TXT_MAX_KB=100

# Supermarket price freshness / split (used in later basket phases)
PRICE_FRESHNESS_HOURS=4
SHOPPING_MAX_SPLIT_STORES=2
SHOPPING_SPLIT_MIN_SAVINGS_ILS=15

# Dev-only price debug page (/dev/prices). Never enable in public production.
# ALLOW_PRICE_DEBUG=true

# Receipt scan (Beta) — server only, never NEXT_PUBLIC_
GEMINI_API_KEY=
# Optional override, default: gemini-2.0-flash
# GEMINI_MODEL=gemini-2.0-flash
